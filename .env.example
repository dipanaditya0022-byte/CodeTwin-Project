# Copy to .env for local overrides. In Azure, set CODETWIN_KEY_VAULT_URL instead and keep
# secrets in Key Vault (codetwin-database-url, codetwin-jwt-secret, codetwin-storage-connection, codetwin-cosmos-key).

# Local SQLite file; for Azure SQL use:
# CODETWIN_DATABASE_URL=mssql://Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=codetwin;Uid=codetwin_app;Pwd=<from Key Vault>;Encrypt=yes;TrustServerCertificate=no;
CODETWIN_DATABASE_URL=sqlite:///./data/codetwin.db
CODETWIN_DATA_DIR=./data

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Against Azure the API refuses to start with the development default or a key under 32 characters.
CODETWIN_JWT_SECRET=change-me
CODETWIN_JWT_MINUTES=30

# local | azure
CODETWIN_STORAGE_BACKEND=local
# CODETWIN_AZURE_STORAGE_CONNECTION_STRING=
# CODETWIN_COSMOS_URL=https://<account>.documents.azure.com:443/
# CODETWIN_COSMOS_KEY=
# CODETWIN_KEY_VAULT_URL=https://<vault>.vault.azure.net/

# hashing (no download) | unixcoder (needs requirements-ml.txt)
CODETWIN_EMBEDDER=hashing

CODETWIN_CORS_ORIGINS=["http://localhost:5173"]

# Proxies in front of the API that append to X-Forwarded-For: 0 locally, 1 on App Service.
# Never set this higher than the real number of proxies, or clients can fake their address.
CODETWIN_TRUSTED_PROXY_HOPS=0

# Largest non-upload request body, in bytes
CODETWIN_MAX_JSON_BYTES=262144

# Worker heartbeat; a running run silent for RUN_STALE_SECONDS is marked failed and can be retried
CODETWIN_RUN_HEARTBEAT_SECONDS=20
CODETWIN_RUN_STALE_SECONDS=300

# Public form submissions per client address per hour (a whole lab often shares one address)
CODETWIN_FORM_MAX_PER_HOUR=120

# Wrong receipt codes per client address per 15 minutes before the results page pauses that address
CODETWIN_RESULTS_MAX_FAILURES=20
