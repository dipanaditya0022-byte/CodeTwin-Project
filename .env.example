# Copy to .env for local overrides. In Azure, set CODETWIN_KEY_VAULT_URL instead and keep
# secrets in Key Vault (codetwin-database-url, codetwin-jwt-secret, codetwin-storage-connection, codetwin-cosmos-key).

# Local SQLite file; for Azure SQL use:
# CODETWIN_DATABASE_URL=mssql://Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=codetwin;Uid=codetwin_app;Pwd=<from Key Vault>;Encrypt=yes;TrustServerCertificate=no;
CODETWIN_DATABASE_URL=sqlite:///./data/codetwin.db
CODETWIN_DATA_DIR=./data

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CODETWIN_JWT_SECRET=change-me
CODETWIN_JWT_MINUTES=30

# local | azure
CODETWIN_STORAGE_BACKEND=local
# CODETWIN_AZURE_STORAGE_CONNECTION_STRING=
# CODETWIN_COSMOS_URL=https://<account>.documents.azure.com:443/
# CODETWIN_COSMOS_KEY=
# CODETWIN_KEY_VAULT_URL=https://<vault>.vault.azure.net/

# hashing (no download) | unixcoder (needs requirements-ml.txt)
CODETWIN_EMBEDDER=hashing

CODETWIN_CORS_ORIGINS=["http://localhost:5173"]
